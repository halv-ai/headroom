# Copy this file to .env and fill in real values before running in production.
# IMPORTANT: Change NEO4J_AUTH before deploying — default credentials are insecure.
NEO4J_AUTH=neo4j/CHANGEME

# OpenAI Responses message compression is opt-in for prefix-cache stability.
HEADROOM_COMPRESS_RESPONSES_MESSAGES=0
# With the global Responses setting, user-role compression is separately opt-in.
HEADROOM_COMPRESS_USER_MESSAGES=0
